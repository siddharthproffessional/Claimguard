# --- AI providers (backend only; never exposed to the frontend) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL_ORCHESTRATOR=claude-fable-5-2
CLAUDE_MODEL_SPECIALIST=claude-fable-5-2
OPENAI_API_KEY=
# Required to enable the independent reviewer, e.g. the OpenAI model you have access to
OPENAI_MODEL=

# none | synthesis | full
AI_DEPTH=synthesis
AI_TIMEOUT_S=45
AI_MAX_TOKENS=1500
AGENT_TIMEOUT_S=60
MAX_AGENT_ITERATIONS=3
CLAIM_CONCURRENCY=6
# If false, an OpenAI challenge is logged but cannot send a READY claim to human review
REVIEWER_CAN_ESCALATE=true

# --- app ---
DATABASE_URL=sqlite:///./claimguard.db
CORS_ORIGINS=*
# JSON overrides; must cover the six dimensions. Weights should sum to 100.
# SCORING_WEIGHTS={"eligibility":20,"documentation":20,"coding":20,"authorization":15,"billing":15,"compliance":10}
# EFFORT_MINUTES={"DOC-002":25}
